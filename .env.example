# Public site URL used for canonical links, sitemap, robots, and Open Graph.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# URL of the MySchool product application (normal login / app entry).
# Distinct from the public demo — do not conflate with NEXT_PUBLIC_DEMO_URL.
# Production example: https://app.example.com
NEXT_PUBLIC_APP_URL=

# Public free demo environment (opens directly; no contact form gate).
# Current supplied environment may be HTTP + raw IP + port (do not auto-rewrite to HTTPS).
# Example (local/dev as currently provided): http://89.116.38.192:8082/login
# TODO(security): replace with a proper HTTPS demo domain in production when one exists
# (conceptually https://demo.<production-domain>). Do not invent a domain here.
NEXT_PUBLIC_DEMO_URL=

# Public contact email shown on the marketing site (also used as the mailto recipient).
NEXT_PUBLIC_CONTACT_EMAIL=alyaarihazem@gmail.com

# Optional public contact phone / WhatsApp (leave empty until confirmed).
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_URL=

# --- Contact form delivery (server-only; never expose secrets to the client) ---
# Leave CONTACT_DELIVERY_PROVIDER empty until a real provider is wired.
# Supported values when implemented: resend | console (dev-only logging)
# CONTACT_DELIVERY_PROVIDER=
# CONTACT_TO_EMAIL=
# RESEND_API_KEY=
